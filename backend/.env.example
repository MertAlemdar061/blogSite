# PostgreSQL bağlantı dizesi (bulut tabanlı, örn. Neon/Supabase/Render)
DATABASE_URL="postgresql://user:password@host:5432/blogdb?schema=public"

# JWT
JWT_SECRET="degistir-bu-cok-gizli-bir-anahtar"
JWT_EXPIRES_IN="7d"

# Sunucu
PORT=3000

# CORS - frontend kaynağı (Vercel URL'si veya localhost)
CORS_ORIGIN="http://localhost:5173"

# İlk admin kullanıcısı (seed için)
ADMIN_EMAIL="admin@blog.com"
ADMIN_PASSWORD="Admin123!"
ADMIN_NAME="Site Yöneticisi"
